# Copy this file to .env and adjust if needed:
#   copy .env.example .env
#
# Never commit .env (real secrets / local overrides).

POSTGRES_DB=appv4
POSTGRES_USER=appv4
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/appv4
SPRING_DATASOURCE_USERNAME=appv4
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_PROFILES_ACTIVE=local

# Google OAuth (SCRUM-96) — console Google Cloud → OAuth client Web
# Redirect URI autorisée (FE) ex. http://localhost:4201/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login (SCRUM-99) — Meta for Developers → App → Facebook Login
# Redirect URI autorisée (FE) ex. http://localhost:4201/auth/callback/facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Sign in with Apple (SCRUM-102) — Apple Developer → Identifiers + Keys
# Redirect URI FE ex. http://localhost:4201/auth/callback/apple
# PRIVATE_KEY = contenu .p8 (remplacer les retours ligne par \n sur une seule ligne)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Compte admin local (SCRUM-142) — seulement le profil local. Ne pas commiter le mot de passe.
APPV4_ADMIN_EMAIL=
APPV4_ADMIN_PASSWORD=
